# Server-side only. Never expose any of these to the frontend.
# BOT_TOKEN, SESSION_SECRET, EVENTS_PEPPER, WEBHOOK_SECRET, METRICS_TOKEN and TURNSTILE_SECRET must all differ from one another.
PORT=8080
# Local development uses compose.yaml, whose password is POSTGRES_PASSWORD below. For any database that is not on this machine
# use sslmode=require (or verify-full) and a strong, unique password.
POSTGRES_PASSWORD=
# Put the same password here in place of CHANGE_ME.
DATABASE_URL=postgres://bestregards:CHANGE_ME@localhost:5432/bestregards?sslmode=disable
# Connections per process. replicas x this must stay below PostgreSQL max_connections.
DB_MAX_CONNS=10
# Token of the Telegram bot that owns the Mini App (from @BotFather).
BOT_TOKEN=
# At least 32 random characters, e.g. `openssl rand -hex 32`. Signs session tokens.
SESSION_SECRET=
# At least 32 random characters. Keys the hash that stands in for a Telegram id in the events table. Keep it secret and STABLE:
# changing it breaks the continuity of per-user metrics.
EVENTS_PEPPER=
# How long events are kept; `bestregards purge` (run it daily, e.g. as a CronJob) deletes older ones and also guest rows older than 44 days.
EVENTS_RETENTION_DAYS=365
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# --- AI translation of a user's own text. Without AI_API_KEY only ready-made pairs work. ---
AI_API_KEY=
# Any OpenAI-compatible API. Recommended: OpenRouter with a cheap PAID model (DeepSeek class), NOT a ":free" one: free models are
# capped per account (20 requests/minute, 1000/day, 50/day under $10 of credits), shared by all users, and a viral spike would take the
# service down. The prices below were taken from OpenRouter's models list on 2026-11-22: re-check them before you launch.
# These two are also the code defaults; set them to use another provider.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-v4-flash
# REQUIRED with AI_API_KEY: provider prices in US dollars per one million tokens. The spending ceiling is computed from them.
AI_PRICE_INPUT_USD_PER_MTOK=0.09
AI_PRICE_OUTPUT_USD_PER_MTOK=0.18
# Daily ceiling for AI translations of everyone together, spread over the 24 hours of the day in QUOTA_TZ.
FREE_BUDGET_USD_PER_DAY=10
# Time zone in which "a day" starts for quotas and the ceiling.
QUOTA_TZ=Europe/Moscow

# --- Guests: anonymous visitors of the website, let in after a Cloudflare Turnstile challenge. Set both or neither. ---
# Without them guests are off and the website works only inside Telegram.
TURNSTILE_SECRET=
# Public; the page needs it to show the challenge.
TURNSTILE_SITE_KEY=
# LOCAL DEVELOPMENT ONLY: lets guests in with no challenge. In production scripts could then mint guests freely and the daily
# ceiling would be the only limit.
# GUESTS_WITHOUT_CHALLENGE=1

# --- Telegram bot webhook: the /start button (opens the Mini App) and the /admin panel. Leave WEBHOOK_SECRET empty to switch it off. ---
# 32-256 characters from A-Z a-z 0-9 _ - ; Telegram sends it back in a header and the service rejects updates without it.
WEBHOOK_SECRET=
# Public https origin of this service, no path. Run `bestregards setup-webhook` once after setting it.
PUBLIC_URL=
# Comma-separated Telegram ids of people who may use /admin (summary, AI spend, user cards, emergency stop of AI translations).
# Optional; empty means nobody can open /admin.
ADMIN_IDS=
# Where /metrics (Prometheus: HTTP traffic, latency and errors, AI failures) is served, e.g. :9090. A separate port, never exposed publicly. Empty = off.
METRICS_ADDR=
# Optional, at least 16 characters: when set, /metrics needs "Authorization: Bearer <token>".
METRICS_TOKEN=
# OpenTelemetry tracing, off by default: set the OTLP/HTTP collector to turn it on (e.g. http://otel-collector:4318).
# Other standard OTEL_* variables apply: OTEL_SERVICE_NAME, OTEL_EXPORTER_OTLP_HEADERS, OTEL_TRACES_SAMPLER(_ARG).
OTEL_EXPORTER_OTLP_ENDPOINT=
